{
  "_about": "IV simulation mode: every clinical number, every step's on-screen text, the three sites' veins and distractors, and the scoring weights (src/core/ivSim.js reads them; src/iv.js draws them). Instructors tune here, not in code. Lengths in mm unless named _cm; times in s; angles in degrees from the skin.",
  "_review": "Open clinical questions from the design doc, as built: steps 10-13 run withdraw needle, close clamp, remove port cap, release tourniquet; the tourniquet is above the elbow for the antecubital and forearm sites and on the distal forearm for the hand (the hand model has no elbow); skin prep is an alcohol pad, 10 s scrub and 15 s dry; flush 10 mL, clamp closed before the syringe comes off; gauge gates the vein (minVein); angle windows below.",

  "procedure": {
    "prep": ["hygiene", "gloves", "patientId", "order"],
    "tourniquet": { "fillS": 25, "releaseS": 10, "warnS": 60, "limitS": 120 },
    "clean": { "radiusMM": 25, "coverage": 0.9, "scrubS": 10, "dryS": 0 },
    "seal": { "breakMinMM": 1, "breakMaxMM": 4, "offMM": 8 },
    "align": { "tolDeg": 10, "acrossDeg": 45 },
    "angles": { "pierceMin": 15, "pierceMax": 30, "steepOver": 35, "lowerMin": 5, "lowerMax": 15, "threadMax": 10, "lowerWithinS": 5 },
    "needle": { "bevelToCathMM": 1.5, "cathLenMM": 25, "needleLenMM": 32, "flashDelayS": 0.3, "flashDelayTqS": 0.15, "flashFillS": 1.0 },
    "vein": {
      "wallMM": 0.4, "punctureMM": 1.1, "pushPerMM": 0.45, "maxPushMM": 2.6, "rollPerMM": 0.6, "maxRollMM": 4,
      "flatPerMM": 0.45, "doubleWallFlat": 0.65, "reboundS": 0.3, "tqSwell": 0.35, "backWallMM": 0.3, "rollOnReleaseMM": 1.2
    },
    "thread": { "tickMM": 2.0, "resistTicks": 3 },
    "flush": { "volumeML": 10, "mlPerMM": 0.25, "maxRateMLs": 1.5, "infiltrationML": 1.5 },
    "dressing": { "tolMM": 9 },
    "twistLockDeg": 90,
    "pressureS": 5,
    "maxDepthMM": 7,
    "gauges": {
      "20": { "odMM": 1.1, "minVeinMM": 3.0, "color": "#f08a9b", "pack": "#f6b3bf", "label": "20 GA 1.00 IN  (1.1 x 25 mm)" },
      "22": { "odMM": 0.9, "minVeinMM": 2.4, "color": "#33c3d3", "pack": "#8fd3e8", "label": "22 GA 1.00 IN  (0.9 x 25 mm)" },
      "24": { "odMM": 0.7, "minVeinMM": 1.8, "color": "#f2cd2c", "pack": "#f5dd6a", "label": "24 GA 0.75 IN  (0.7 x 19 mm)" }
    }
  },

  "steps": [
    { "id": "prep", "title": "Prep", "do": "Tick each item.", "keys": [["Click", "tick"]] },
    { "id": "tourniquet", "title": "Apply tourniquet", "do": "Above the elbow.", "keys": [["Tool", "tourniquet"], ["Click", "the arm"]] },
    { "id": "palpate", "title": "Find a vein", "do": "Feel for a bouncy, straight vein, then mark it.", "keys": [["Hold F", "palpate"], ["Click", "mark"]] },
    { "id": "clean", "title": "Clean the site", "do": "Open a swab, then scrub the whole circle.", "keys": [["Tool", "alcohol swab"], ["Hold + drag", "scrub"]] },
    { "id": "seal", "title": "Break the seal", "do": "Open the IV. Slide the catheter 1 mm off the needle, then back.", "keys": [["Drag →", "break"], ["Drag ←", "reseat"]] },
    { "id": "align", "title": "Line up with the vein", "do": "Point the needle along the vein.", "keys": [["Q / E", "rotate"]] },
    { "id": "anchor", "title": "Anchor the skin", "do": "Hold traction until the catheter is in.", "keys": [["Hold Space", "traction"]] },
    { "id": "insert", "title": "Insert", "do": "Pierce at 15-30°. Watch the flash chamber.", "keys": [["Hold Space", "traction"], ["Drag ↕", "advance"], ["Right-drag ↕", "angle"]] },
    { "id": "flash", "title": "Flashback", "do": "Lower the angle, then advance 1-2 mm more.", "keys": [["Right-drag ↕", "angle"], ["Drag ↕", "advance"]] },
    { "id": "thread", "title": "Thread the catheter", "do": "Keep the needle still; push the catheter in.", "keys": [["Hold Space", "traction"], ["Wheel ↑", "thread"]] },
    { "id": "withdraw", "title": "Withdraw the needle", "do": "Pull it back into its shield.", "keys": [["Drag ↓", "on the needle"]] },
    { "id": "clamp1", "title": "Close the clamp", "do": "Before opening the system.", "keys": [["Click", "clamp"]], "critical": true },
    { "id": "portcap", "title": "Remove the port cap", "do": "", "keys": [["Click", "port cap"]] },
    { "id": "tqoff", "title": "Release the tourniquet", "do": "", "keys": [["Click", "tourniquet"]], "critical": true },
    { "id": "dressing", "title": "Apply Tegaderm", "do": "Window over the site, then press each edge.", "keys": [["Tool", "Tegaderm"], ["Click", "site, then edges"]] },
    { "id": "syringe", "title": "Attach the flush", "do": "", "keys": [["Tool", "syringe"], ["Click", "port"], ["Q / E", "twist"]] },
    { "id": "clamp2", "title": "Open the clamp", "do": "", "keys": [["Click", "clamp"]] },
    { "id": "flush", "title": "Flush", "do": "10 mL, steadily. Stop if it swells.", "keys": [["Drag ↑", "plunger"]] },
    { "id": "clamp3", "title": "Close the clamp", "do": "Before the syringe comes off.", "keys": [["Click", "clamp"]], "critical": true },
    { "id": "syringeOff", "title": "Remove the flush", "do": "", "keys": [["Q / E", "twist off"]] },
    { "id": "cap", "title": "Cap the port", "do": "", "keys": [["Tool", "cap"], ["Click", "port"], ["Q / E", "twist"]] }
  ],

